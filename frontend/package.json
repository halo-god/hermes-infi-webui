    "katex": "^0.17.0",
    "markdown-it": "^14.2.0",
    "mermaid": "^11.15.0",
    "naive-ui": "^2.44.1",
    "pinia": "^2.1.7",
    "shiki": "^4.4.2",
    "vue": "^3.4.38",
    "vue-i18n": "^9.14.5",
    "vue-router": "^4.4.0"
  },
  "devDependencies": {
